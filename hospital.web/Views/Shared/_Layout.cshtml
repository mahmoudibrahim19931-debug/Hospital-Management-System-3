@using Microsoft.AspNetCore.Identity
@using Hospital.Models

@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
@inject Hospital.Services.INotificationService NotificationService
@using System.Security.Claims

@{

    var userId =
        User.FindFirst(
            ClaimTypes.NameIdentifier)
            ?.Value;


    var unreadCount = 0;



    if (!string.IsNullOrEmpty(userId))
    {

        unreadCount =
            NotificationService
            .UnreadCount(userId);

    }

}

<!DOCTYPE html>
<html lang="en">
<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1" />

    <title>@ViewData["Title"] | Hospital Management System</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/hospital.web.styles.css"
          asp-append-version="true" />

</head>

<body>

    
    

    <header>

        <nav class="navbar navbar-expand-lg navbar-dark shadow-sm"
             style="background:#0F4C81;">

            <div class="container-fluid">

                <a class="navbar-brand fw-bold"
                       asp-area=""
                       asp-controller="Home"
                       asp-action="Index">

                    <i class="fa-solid fa-hospital me-2"></i>

                    HospitalMS

                </a>

                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#navbar">

                    <span class="navbar-toggler-icon"></span>

                </button>

                <div class="collapse navbar-collapse"
                     id="navbar">

                    <ul class="navbar-nav me-auto">

                        <li class="nav-item">

                            <a class="nav-link"
                                   asp-area=""
                                   asp-controller="Home"
                                   asp-action="Index">

                                <i class="fa-solid fa-house me-1"></i>

                                Home

                            </a>

                        </li>

                        @if (User.IsInRole("Admin"))
                        {

                            <li class="nav-item">

                                <a class="nav-link"
                                       asp-area="Admin"
                                       asp-controller="Dashboard"
                                       asp-action="Index">

                                    <i class="fa-solid fa-chart-column me-1"></i>

                                    Dashboard

                                </a>

                            </li>

                            <li class="nav-item">

                                <a class="nav-link"
                                       asp-area="Admin"
                                       asp-controller="Hospitals"
                                       asp-action="Index">

                                    <i class="fa-solid fa-hospital me-1"></i>

                                    Hospitals

                                </a>

                            </li>

                            <li class="nav-item">

                                <a class="nav-link"
                                       asp-area="Admin"
                                       asp-controller="Rooms"
                                       asp-action="Index">

                                    <i class="fa-solid fa-door-open me-1"></i>

                                    Rooms

                                </a>

                            </li>

                            <li class="nav-item">

                                <a class="nav-link"
                                       asp-area="Admin"
                                       asp-controller="Users"
                                       asp-action="AllDoctors">

                                    <i class="fa-solid fa-user-doctor me-1"></i>

                                    Doctors

                                </a>

                            </li>

                            <li class="nav-item">

                                <a class="nav-link"
                                       asp-area="Admin"
                                       asp-controller="Users"
                                       asp-action="Index">

                                    <i class="fa-solid fa-bed-pulse me-1"></i>

                                    Patients

                                </a>

                            </li>

                            <li class="nav-item">

                                <a class="nav-link"
                                       asp-area="Admin"
                                       asp-controller="Appointments"
                                       asp-action="Index">

                                    <i class="fa-solid fa-calendar-check me-1"></i>

                                    Appointments

                                </a>

                            </li>

                            <li class="nav-item">

                                <a class="nav-link"
                                       asp-area="Admin"
                                       asp-controller="Medicines"
                                       asp-action="Index">

                                    <i class="fa-solid fa-pills me-1"></i>

                                    Medicines

                                </a>

                            </li>

                            <li class="nav-item">

                                <a class="nav-link"
                                       asp-area="Admin"
                                       asp-controller="Suppliers"
                                       asp-action="Index">

                                    <i class="fa-solid fa-truck me-1"></i>

                                    Suppliers

                                </a>

                            </li>

                        }

                        @if (User.IsInRole("Doctor"))
                        {

                            <li class="nav-item">

                                <a class="nav-link"
                                       asp-area="Doctor"
                                       asp-controller="DoctorDashboard"
                                       asp-action="Index">

                                    <i class="fa-solid fa-chart-line me-1"></i>

                                    Dashboard

                                </a>

                            </li>

                            <li class="nav-item">

                                <a class="nav-link"
                                       asp-area="Doctor"
                                       asp-controller="Patients"
                                       asp-action="Index">

                                    <i class="fa-solid fa-user-group me-1"></i>

                                    Patients

                                </a>

                            </li>

                            <li class="nav-item">

                                <a class="nav-link"
                                       asp-area="Doctor"
                                       asp-controller="Calendar"
                                       asp-action="Index">

                                    <i class="fa-solid fa-calendar-days me-1"></i>

                                    Calendar

                                </a>

                            </li>

                        }

                        @if (User.IsInRole("Patient"))
                        {

                            <li class="nav-item">

                                <a class="nav-link"
                                       asp-area="Patient"
                                       asp-controller="Home"
                                       asp-action="Index">

                                    <i class="fa-solid fa-user me-1"></i>

                                    My Dashboard

                                </a>

                            </li>

                        }

                    </ul>

                    <ul class="navbar-nav align-items-center">

                        @if (User.Identity.IsAuthenticated)
                        {

                            <li class="nav-item dropdown">

                                <a class="nav-link dropdown-toggle"
                                       href="#"
                                       role="button"
                                       data-bs-toggle="dropdown">

                                    <i class="fa-solid fa-bell"></i>

                                    @if (unreadCount > 0)
                                    {
                                        <span class="badge bg-danger">

                                            @unreadCount

                                        </span>
                                    }

                                </a>

                                <ul class="dropdown-menu dropdown-menu-end">

                                    <li>

                                        <a class="dropdown-item"
                                               asp-area="Notification"
                                               asp-controller="Notifications"
                                               asp-action="Index">

                                            <i class="fa-solid fa-envelope me-2"></i>

                                            Notifications

                                        </a>

                                    </li>

                                </ul>

                            </li>

                        }

                        <partial name="_LoginPartial" />

                    </ul>

                </div>

            </div>

        </nav>

    </header>

    <div class="container">

        <main role="main" class="pb-3">

            @RenderBody()

        </main>

    </div>

   

    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>