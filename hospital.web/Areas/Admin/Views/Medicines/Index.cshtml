@model List<Hospital.ViewModels.MedicineViewModel>

<h2>Medicine Inventory</h2>

<form method="get">

    <input name="search"
           class="form-control"
           placeholder="Search medicine..." />

    <button class="btn btn-primary mt-2">

        Search

    </button>

</form>

------

<p>

    <a asp-action="Create"
           class="btn btn-primary">

        Add Medicine

    </a>

</p>


<table class="table table-bordered">

    <thead>

        <tr>

            <th>Name</th>

            <th>Type</th>

            <th>Supplier</th>

            <th>Quantity</th>

            <th>Minimum</th>

            <th>Cost</th>

            <th>Status</th>

            <th>Actions</th>

        </tr>

    </thead>



    <tbody>

        @foreach (var medicine in Model)
        {

            <tr>

                <td>

                    @medicine.Name

                </td>



                <td>

                    @medicine.Type

                </td>



                <td>

                    @medicine.SupplierName

                </td>



                <td>

                    @medicine.Quantity

                </td>



                <td>

                    @medicine.MinimumQuantity

                </td>



                <td>

                    @medicine.Cost

                </td>



                <td>

                    @if (medicine.Quantity == 0)
                    {

                        <span class="badge bg-danger">

                            Out Of Stock

                        </span>

                    }
                    else if (medicine.Quantity <= medicine.MinimumQuantity)
                    {

                        <span class="badge bg-warning">

                            Low Stock

                        </span>

                    }
                    else
                    {

                        <span class="badge bg-success">

                            In Stock

                        </span>

                    }

                </td>

                <td>

                    <a asp-action="Restock"
                           asp-route-id="@medicine.Id"
                           class="btn btn-success">


                        Restock


                    </a>

                    <a asp-action="Details"
                           asp-route-id="@medicine.Id"
                           class="btn btn-info">

                        History

                    </a>


                </td>


            </tr>

        }

    </tbody>

</table>

