@using cloudscribe.Pagination.Models
@using Hospital.Models
@model Hospital.Utilities.PagedResult<Hospital.ViewModels.RoomViewModel>

@{
    ViewData["Title"] = "Rooms";
}

<div class="container-fluid">
    <form method="get" class="row mb-4">

        <div class="col-md-3">
            <input type="text"
                   name="search"
                   value="@ViewBag.Search"
                   class="form-control"
                   placeholder="Search Room Number" />
        </div>

        <div class="col-md-3">

            <select name="type" class="form-select">

                <option value="">All Types</option>

                @foreach (var item in Html.GetEnumSelectList<Hospital.Models.RoomType>())
                {
                    <option value="@item.Value"
                            selected="@(ViewBag.Type?.ToString() == item.Value)">
                        @item.Text
                    </option>
                }

            </select>

        </div>

        <div class="col-md-3">

            <select name="status" class="form-select">

                <option value="">All Status</option>

                @foreach (var item in Html.GetEnumSelectList<Hospital.Models.RoomStatus>())
                {
                    <option value="@item.Value"
                            selected="@(ViewBag.Status?.ToString() == item.Value)">
                        @item.Text
                    </option>
                }

            </select>

        </div>

        <div class="col-md-3">

            <button class="btn btn-primary w-100">

                Search

            </button>

        </div>

    </form>

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="mb-0">
            <i class="fas fa-bed"></i> Rooms
        </h2>

        <a asp-action="Create" class="btn btn-primary">
            <i class="fas fa-plus"></i> Add Room
        </a>
    </div>

    <div class="card shadow-sm">

        <div class="card-body p-0">

            <table class="table table-hover table-striped mb-0">

                <thead class="table-dark">
                    <tr>
                        <th>Room No.</th>
                        <th>Hospital</th>
                        <th>Patient</th>
                        <th>Type</th>
                        <th>Status</th>
                        <th>Capacity</th>
                        <th>Occupied</th>
                        <th>Daily Rate</th>
                        <th>Floor</th>
                        <th width="220">Actions</th>
                    </tr>
                </thead>

                <tbody>

                    @if (Model.Data.Any())
                    {
                        foreach (var item in Model.Data)
                        {
                            <tr>

                                <td>
                                    <strong>@item.RoomNumber</strong>
                                </td>

                                <td>
                                    @(string.IsNullOrEmpty(item.HospitalName)
                                        ? "N/A"
                                        : item.HospitalName)
                                </td>

                                <td>
                                    @(string.IsNullOrEmpty(item.PatientName)
                                        ? "No Patient"
                                        : item.PatientName)
                                </td>

                                <td>
                                    @item.Type
                                </td>

                                <td>

                                    @switch (item.Status)
                                    {
                                        case RoomStatus.Available:
                                            <span class="badge bg-success">
                                                Available
                                            </span>
                                            break;

                                        case RoomStatus.Occupied:
                                            <span class="badge bg-danger">
                                                Occupied
                                            </span>
                                            break;

                                        case RoomStatus.Cleaning:
                                            <span class="badge bg-warning text-dark">
                                                Cleaning
                                            </span>
                                            break;

                                        case RoomStatus.Maintenance:
                                            <span class="badge bg-secondary">
                                                Maintenance
                                            </span>
                                            break;

                                        case RoomStatus.Reserved:
                                            <span class="badge bg-primary">
                                                Reserved
                                            </span>
                                            break;
                                    }

                                </td>

                                <td>
                                    @item.Capacity
                                </td>

                                <td>
                                    @item.OccupiedBeds
                                </td>

                                <td>
                                    @item.DailyRate.ToString("0.00")
                                </td>

                                <td>
                                    @item.Floor
                                </td>

                                <td>

                                    <a asp-action="Details"
                                           asp-route-id="@item.Id"
                                           class="btn btn-info btn-sm">
                                        Details
                                    </a>

                                    <a asp-action="Edit"
                                           asp-route-id="@item.Id"
                                           class="btn btn-warning btn-sm">
                                        Edit
                                    </a>

                                    <a asp-action="Delete"
                                           asp-route-id="@item.Id"
                                           class="btn btn-danger btn-sm">
                                        Delete
                                    </a>

                                </td>

                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="10" class="text-center p-4">
                                <h5>No Rooms Found</h5>
                            </td>
                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

    <div class="mt-3">

        <cs-pager cs-paging-pagesize="(int)Model.PageSize"
                  cs-paging-pagenumber="(int)Model.PageNumber"
                  cs-paging-totalitems="(int)Model.TotalItems"
                  cs-pagenumber-param="pageNumber"
                  asp-controller="Rooms"
                  asp-action="Index"
                  cs-pager-li-current-class="page-item active"
                  cs-pager-li-other-class="page-item"
                  cs-pager-li-non-active-class="page-item disabled"
                  cs-pager-link-current-class="page-link"
                  cs-pager-link-other-class="page-link">
        </cs-pager>

    </div>

</div>