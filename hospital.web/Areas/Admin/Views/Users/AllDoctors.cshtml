@model Hospital.Utilities.PagedResult<Hospital.ViewModels.ApplicationUserViewModel>

@{
    ViewData["Title"] = "Doctor List";
}

<h1>Doctor List</h1>

<table class="table table-bordered table-striped">

    <thead>
        <tr>
            <th>Name</th>
            <th>Address</th>
            <th>Email</th>
            <th>UserName</th>
            <th>Gender</th>
            <th>Specilist</th>
            <th>Actions</th>
        </tr>
    </thead>

    <tbody>

        @foreach (var item in Model.Data)
        {
            <tr>

                <td>@item.Name</td>
                <td>@item.Address</td>
                <td>@item.Email</td>
                <td>@item.UserName</td>
                <td>@item.Gender</td>
                <td>@item.Specilist</td>

                <td>

                    <a asp-area="Admin"
                           asp-controller="Users"
                           asp-action="DoctorDetails"
                           asp-route-id="@item.Id"
                           class="btn btn-info btn-sm">
                        Details


                    </a>

                    <a asp-area="Admin"
                           asp-controller="Users"
                           asp-action="Edit"
                           asp-route-id="@item.Id"
                           class="btn btn-warning btn-sm">
                        Edit
                    </a>

                    <a asp-action="DoctorAppointments"
                           asp-route-id="@item.Id"
                           class="btn btn-info btn-sm">
                        Appointments
                    </a>

                </td>

            </tr>
        }

    </tbody>

</table>