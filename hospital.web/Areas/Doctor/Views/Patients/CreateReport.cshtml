@model Hospital.ViewModels.PatientReportViewModel

<h2>Create Medical Report</h2>

<form asp-action="CreateReport" method="post">

    <input type="hidden"
           asp-for="PatientId" />


    <div class="mb-3">

        <label asp-for="Diagnose"
               class="form-label">
        </label>

        <textarea asp-for="Diagnose"
                  class="form-control"
                      rows="5">
        </textarea>

        </div>

        <div class="form-group">

            <label>

                Prescription

            </label>


            <textarea asp-for="Prescription"
                      class="form-control"
                          rows="6">

    </textarea>

            </div>


        <div class="mb-3">

            <label class="form-label">

                Medicines

            </label>


            <select asp-for="SelectedMedicineIds"
                    class="form-control"
                    multiple>


                @foreach (var medicine in Model.AvailableMedicines)
                {

                    @if (medicine.Quantity > 0)
                    {

                        <option value="@medicine.Id">

                            @medicine.Name

                            (Available : @medicine.Quantity)

                        </option>

                    }
                    else
                    {

                        <option disabled>

                            @medicine.Name

                            (Out Of Stock)

                        </option>

                    }

                }


            </select>


        </div>




        <button type="submit"
                class="btn btn-primary">

            Save Report

        </button>

    </form>