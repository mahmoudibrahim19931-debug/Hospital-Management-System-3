@model List<Hospital.Models.PatientInsurance>

<h2>My Insurance</h2>

<hr />

<form asp-action="SelectInsurance" method="post">

    <select name="insuranceId" class="form-control">

        @foreach (var item in ViewBag.AvailableInsurances)
        {
            <option value="@item.Id">

                @item.Name

                (@item.DiscountPercentage%)

            </option>
        }

    </select>

    <br />

    <button class="btn btn-success">

        Select

    </button>

</form>

<hr />

<table class="table table-bordered table-striped">

    <thead>

        <tr>

            <th>Name</th>

            <th>Discount</th>

            <th>Start Date</th>

            <th>End Date</th>

            <th>Status</th>

        </tr>

    </thead>

    <tbody>

        @if (Model.Any())
        {

            @foreach (var item in Model)
            {

                <tr>

                    <td>

                        @item.Insurance?.Name

                    </td>

                    <td>

                        @item.Insurance?.DiscountPercentage %

                    </td>

                    <td>

                        @item.StartDate.ToShortDateString()

                    </td>

                    <td>

                        @if (item.EndDate.HasValue)
                        {
                            @item.EndDate.Value.ToShortDateString()
                        }
                        else
                        {
                            <span>-</span>
                        }

                    </td>

                    <td>

                        @if (!item.IsApproved)
                        {

                            <span class="badge bg-warning">

                                Pending Approval

                            </span>

                        }
                        else if (item.IsActive)
                        {

                            <span class="badge bg-success">

                                Active

                            </span>

                        }
                        else
                        {

                            <span class="badge bg-secondary">

                                Old

                            </span>

                        }

                    </td>

                </tr>

            }

        }
        else
        {

            <tr>

                <td colspan="5">

                    No Insurance Records Found

                </td>

            </tr>

        }

    </tbody>

</table>